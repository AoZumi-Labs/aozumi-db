+/// AOZUMI PATCH: a cap on the WAL frames a connection's read transactions
+/// see, shared by the connections of one database. The server sets it to
+/// the last commit it has flushed (`(checkpoint_seq, max_frame)`), so that
+/// readers never see a commit that is not on disk yet. A reader's snapshot
+/// is `min(shared max_frame, cap)`, never below the frames already
+/// checkpointed into the database file (those were flushed first). A cap
+/// from an older WAL generation means only the database file is known to
+/// be on disk. A capped connection cannot upgrade to a writer while frames
+/// past the cap exist: its snapshot is stale, and the upgrade fails with
+/// `BusySnapshot` as for any stale reader.
+#[derive(Debug, Default)]
+pub struct ReadCap(Mutex<Option<(u32, u64)>>);
+
+impl ReadCap {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Readers see the WAL up to `frame` of generation `checkpoint_seq`.
+    pub fn set(&self, checkpoint_seq: u32, frame: u64) {
+        *self.0.lock() = Some((checkpoint_seq, frame));
+    }
+
+    pub fn get(&self) -> Option<(u32, u64)> {
+        *self.0.lock()
+    }
+
+    /// The highest frame a reader may see, given the shared snapshot.
+    fn read_max(&self, snapshot: &WalSnapshot) -> u64 {
+        match self.get() {
+            // Nothing known to be on disk past the database file yet.
+            None => snapshot.nbackfills,
+            Some((seq, frame)) if seq == snapshot.checkpoint_seq => {
+                frame.clamp(snapshot.nbackfills, snapshot.max_frame)
+            }
+            Some((seq, _)) if seq < snapshot.checkpoint_seq => snapshot.nbackfills,
+            // A cap from a newer generation than this snapshot: stale
+            // snapshot, nothing to hold back.
+            Some(_) => snapshot.max_frame,
+        }
+    }
+}
